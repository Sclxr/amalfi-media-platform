# Copy to .env. Never commit real values.
# Names only. Put secrets in the host's secret store.

# Do not set NODE_ENV here. Next.js sets it. Overriding it breaks `next build`.
# development | test | staging | production
APP_ENV=development
# Local: http://localhost:3000
# Staging: https://staging.amalfimedia.xyz
# Production app host: https://app.amalfimedia.xyz
APP_URL=http://localhost:3000

# Direct Postgres URL. On the VPS this is the compose service, not a pooler.
DATABASE_URL=
# Optional. Set this only when DATABASE_URL is a pooler. Startup copies DATABASE_URL when it is empty.
DIRECT_URL=

# Files on disk. Staging must include a staging path segment. Production must not.
MEDIA_ROOT=
# Optional. Max photo upload in bytes. Default 52428800 (50 MB). Ceiling 536870912 (512 MB).
MEDIA_MAX_UPLOAD_BYTES=

# 32+ characters. openssl rand -base64 32
AUTH_SECRET=
ENCRYPTION_KEY=

# Hard-off outside production. The server refuses to boot if this is true unless APP_ENV=production.
EMAIL_MARKETING_ENABLED=false
# Production sends when this is true and a provider is set.
# Staging also sends when EMAIL_STAGING_SEND=true. Development and test only log a preview.
EMAIL_TRANSACTIONAL_ENABLED=false
# Staging only. true delivers mail. An empty allowlist still sends to every recipient; set the list.
EMAIL_STAGING_SEND=false
EMAIL_STAGING_ALLOWLIST=
# Local only. Stores the last transactional message in AppSetting. Keep false on staging and production.
EMAIL_DEV_PREVIEW=false
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Gmail stays a stub. true does not place a live call. See docs/GMAIL_OAUTH.md.
GMAIL_API_ENABLED=false

# Required when APP_ENV=staging. Format username:password. Gates the whole app except /portal/api/health.
STAGING_BASIC_AUTH=

# Stripe. Staging accepts only sk_test_ / pk_test_. Leave blank until billing is wired.
# STRIPE_WEBHOOK_SECRET may list more than one secret, separated by commas, while you rotate it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional leftover S3 settings. The app stores files on MEDIA_ROOT, not in a bucket.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional. Errors are logged with pino when this is empty.
SENTRY_DSN=

LOG_LEVEL=info

# Required for seed when APP_ENV is staging or production.
# Local development falls back to the documented demo password when this is empty.
SEED_ADMIN_PASSWORD=
