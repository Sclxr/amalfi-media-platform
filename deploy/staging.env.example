# Copy to deploy/staging.env (this directory) and chmod 600. Do not commit the copy.
# Compose only interpolates ${POSTGRES_PASSWORD} and ${STAGING_MEDIA_DIR} when you pass
# --env-file staging.env. The env_file: key inside the compose file does not do that.
APP_ENV=staging
APP_URL=http://127.0.0.1:8081
POSTGRES_PASSWORD=replace-with-a-long-staging-db-password
DATABASE_URL=postgresql://amalfi_staging:replace-with-a-long-staging-db-password@postgres:5432/amalfi_staging
DIRECT_URL=postgresql://amalfi_staging:replace-with-a-long-staging-db-password@postgres:5432/amalfi_staging
AUTH_SECRET=replace-with-32-plus-random-characters
ENCRYPTION_KEY=replace-with-a-different-32-plus-random-string
EMAIL_MARKETING_ENABLED=false
# Both must be true before staging delivers mail. An empty allowlist sends to every recipient.
EMAIL_TRANSACTIONAL_ENABLED=false
EMAIL_STAGING_SEND=false
EMAIL_STAGING_ALLOWLIST=
EMAIL_DEV_PREVIEW=false
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
STAGING_BASIC_AUTH=preview:replace-with-a-gate-password
# Webhook secret may be comma-separated while rotating. No new variables are required for checkout checks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
MEDIA_ROOT=/var/lib/amalfi/staging/media
STAGING_MEDIA_DIR=/var/lib/amalfi/staging/media
SEED_ADMIN_PASSWORD=replace-with-a-staging-admin-password
LOG_LEVEL=info
BACKUP_PASSPHRASE=replace-with-a-backup-passphrase
