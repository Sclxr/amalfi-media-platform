# Copy to deploy/production.env (this directory) and chmod 600. Do not commit the copy.
# Pass it on every compose command: --env-file production.env
# That is what interpolates ${POSTGRES_PASSWORD} and ${PRODUCTION_MEDIA_DIR}.
APP_ENV=production
APP_URL=https://app.amalfimedia.xyz
POSTGRES_PASSWORD=replace-with-a-long-production-db-password
DATABASE_URL=postgresql://amalfi_prod:replace-with-a-long-production-db-password@postgres:5432/amalfi_prod
DIRECT_URL=postgresql://amalfi_prod:replace-with-a-long-production-db-password@postgres:5432/amalfi_prod
AUTH_SECRET=replace-with-32-plus-random-characters
ENCRYPTION_KEY=replace-with-a-different-32-plus-random-string
EMAIL_MARKETING_ENABLED=false
# Set true plus EMAIL_PROVIDER, EMAIL_FROM, and either RESEND_API_KEY or SMTP_* to send.
# EMAIL_STAGING_SEND and EMAIL_STAGING_ALLOWLIST apply only when APP_ENV=staging.
EMAIL_TRANSACTIONAL_ENABLED=false
EMAIL_DEV_PREVIEW=false
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Webhook secret may be comma-separated while rotating.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
MEDIA_ROOT=/var/lib/amalfi/production/media
PRODUCTION_MEDIA_DIR=/var/lib/amalfi/production/media
SEED_ADMIN_PASSWORD=replace-with-a-production-admin-password
LOG_LEVEL=info
BACKUP_PASSPHRASE=replace-with-a-different-backup-passphrase
