---
import { money, site } from "../site.config";
const packages = [
  { value: "Basic listing", label: `Basic listing (${money(site.prices.basic)})` },
  { value: "Complete listing", label: `Complete listing (${money(site.prices.complete)})` },
  { value: "Photography", label: `Photography (${money(site.prices.photo)})` },
  { value: "Drone", label: `Drone (${money(site.prices.drone)})` },
  { value: "Video", label: `Video (${money(site.prices.video)})` },
  { value: "Not sure", label: "Not sure yet" },
];
---
<form class="form" action={site.form.action} method="POST">
  <input type="hidden" name="_subject" value={site.form.subject} />
  <input type="hidden" name="_captcha" value={site.form.captcha ? "true" : "false"} />
  <input type="hidden" name="_template" value={site.form.template} />
  <input type="hidden" name="_next" value={site.form.next} />
  <p class="hp" aria-hidden="true">
    <label>Leave this empty<input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label>
  </p>
  <label>Name<input name="name" autocomplete="name" required /></label>
  <label>Email<input name="email" type="email" autocomplete="email" required /></label>
  <label>Phone<input name="phone" type="tel" autocomplete="tel" required /></label>
  <label>Property address<input name="property_address" autocomplete="street-address" required /></label>
  <label>Package
    <select name="package" required>
      <option value="">Choose a package</option>
      {packages.map((item) => <option value={item.value}>{item.label}</option>)}
    </select>
  </label>
  <label>Preferred date<input name="preferred_date" type="date" required /></label>
  <label>Notes<textarea name="notes"></textarea></label>
  <button class="btn btn-gold" type="submit">Request the shoot</button>
  <p>The form opens a short check before it is delivered. Nothing is sent until you submit.</p>
</form>
