---
import "@fontsource/big-shoulders-display/latin-800";
import "@fontsource/manrope/latin-400";
import "@fontsource/manrope/latin-500";
import "@fontsource/manrope/latin-600";
import "@fontsource/manrope/latin-700";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";
import { isProduction } from "../mode";

interface Props {
  title: string;
  description: string;
  path: string;
}
const { title, description, path } = Astro.props;
const canonical = new URL(path, site.url).toString();
const og = new URL("/og.webp", site.url).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  url: site.url,
  email: site.email,
  telephone: site.phone.dial,
  image: og,
  areaServed: [
    { "@type": "AdministrativeArea", name: "Greater Orlando" },
    ...site.areas.cities.map((name) => ({ "@type": "City", name })),
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {isProduction ? null : <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.seo.googleSiteVerification ? (
      <meta name="google-site-verification" content={site.seo.googleSiteVerification} />
    ) : null}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {site.analyticsId ? (
      <Fragment
        set:html={`<script async src="https://www.googletagmanager.com/gtag/js?id=${site.analyticsId}"></script><script>window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());gtag('config', '${site.analyticsId}');</script>`}
      />
    ) : null}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="sticky">
      {site.phone.dial ? (
        <a class="btn btn-ghost" href={`tel:${site.phone.dial}`}>Call</a>
      ) : (
        <span class="btn btn-ghost" role="link" aria-disabled="true">Call</span>
      )}
      <a class="btn btn-gold" href="/book/">Book a shoot</a>
    </div>
    <script>
      const bar = document.querySelector(".sticky");
      const hero = document.querySelector(".hero");
      const updateBar = () => {
        if (!bar) return;
        const pastHero = !hero || window.scrollY > hero.getBoundingClientRect().bottom + window.scrollY - 24;
        bar.classList.toggle("is-visible", pastHero);
      };
      updateBar();
      window.addEventListener("scroll", updateBar, { passive: true });
    </script>
  </body>
</html>
