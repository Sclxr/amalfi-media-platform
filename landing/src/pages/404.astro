---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found | Amalfi Media" description="That page is not on the Amalfi Media site." path="/404.html">
  <section class="page-hero wrap">
    <p class="eyebrow">404</p>
    <h1 class="display">That page is <span class="gold">gone.</span></h1>
    <p class="lead">The address does not match a page. Try the portfolio or book a shoot.</p>
    <a class="btn btn-gold" href="/">Home</a>
    <a class="btn btn-ghost" href="/portfolio/">Portfolio</a>
  </section>
</Base>
