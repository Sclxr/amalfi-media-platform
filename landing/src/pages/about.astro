---
import Base from "../layouts/Base.astro";
import { site } from "../site.config";
---
<Base title="About Amalfi Media" description="Eathen photographs real estate, drone aerials, and walkthrough video for agents across the greater Orlando area." path="/about/">
  <section class="page-hero wrap">
    <p class="eyebrow">About</p>
    <h1 class="display">Orlando listing <span class="gold">media</span></h1>
  </section>
  <section class="sec sec-light">
    <div class="wrap about-layout">
      <div class="about-copy">
        {site.about.headshot ? <img class="about-photo" src={site.about.headshot} alt="" /> : null}
        {site.about.bio ? <p class="about-bio">{site.about.bio}</p> : <p class="about-bio">{site.description}</p>}
      </div>
      <aside class="panel about-contact">
        <h2>Contact</h2>
        <p>{site.areas.summary}.</p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p><a href={`tel:${site.phone.dial}`}>{site.phone.display}</a></p>
      </aside>
    </div>
  </section>
</Base>
