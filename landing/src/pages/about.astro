---
import Base from "../layouts/Base.astro";
import { site } from "../site.config";
import { isProduction } from "../mode";
const showPortrait = Boolean(site.about.headshot || site.about.bio) || !isProduction;
const showClaims = site.claims.faaPart107 || site.claims.insured || site.claims.turnaround24h || !isProduction;
---
<Base title="About Amalfi Media" description="Amalfi Media photographs Orlando listings. Bio, headshot, and credentials are published only when confirmed." path="/about/">
  <section class="page-hero wrap">
    <p class="eyebrow">About</p>
    <h1 class="display">Orlando listing <span class="gold">media</span></h1>
  </section>
  <section class="sec sec-light">
    <div class="wrap cards">
      {showPortrait ? (
        <article class="panel">
          <h2>Portrait</h2>
          {site.about.headshot ? <img src={site.about.headshot} alt="" /> : isProduction ? null : <p class="placeholder">Headshot not provided.</p>}
          {site.about.bio ? <p>{site.about.bio}</p> : isProduction ? null : <p class="placeholder">Bio not provided. Add it in the site config before publishing a personal story.</p>}
        </article>
      ) : null}
      <article class="panel">
        <h2>Credentials</h2>
        {showClaims ? (
          <ul>
            {site.claims.faaPart107 || !isProduction ? <li>{site.claims.faaPart107 ? "FAA Part 107 pilot" : "FAA Part 107: not confirmed"}</li> : null}
            {site.claims.insured || !isProduction ? <li>{site.claims.insured ? "Insured" : "Insurance: not confirmed"}</li> : null}
            {site.claims.turnaround24h || !isProduction ? <li>{site.claims.turnaround24h ? "24-hour delivery" : "24-hour turnaround: not confirmed"}</li> : null}
          </ul>
        ) : <p>Credentials are published only after they are confirmed.</p>}
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </article>
    </div>
  </section>
</Base>
