---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import { shots } from "../data/gallery";
const filters = ["all", "photo", "drone", "video", "twilight"];
---
<Base title="Real Estate Portfolio | Amalfi Media" description="Listing photos, twilight exteriors, and drone aerials from Amalfi Media." path="/portfolio/">
  <section class="page-hero wrap">
    <p class="eyebrow">Portfolio</p>
    <h1 class="display">The <span class="gold">work</span></h1>
    <p class="lead">Filter the stills. Walkthrough clips are not on this page yet.</p>
  </section>
  <section class="sec sec-light">
    <div class="wrap">
      <div class="filters" role="group" aria-label="Filter work">
        {filters.map((filter, index) => (
          <button class="btn btn-ghost" type="button" data-filter={filter} aria-pressed={index === 0 ? "true" : "false"} style="color:#0a0a0a;border-color:#ccc">{filter}</button>
        ))}
      </div>
      <div class="gallery" id="work">
        {shots.map((shot) => (
          <figure class="shot" data-tags={shot.tags.join(" ")}>
            <Picture src={shot.src} formats={["avif", "webp"]} fallbackFormat="webp" widths={[480, 900]} alt={shot.alt} loading="lazy" />
            <figcaption>{shot.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Base>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const items = document.querySelectorAll<HTMLElement>("[data-tags]");
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter || "all";
      buttons.forEach((item) => item.setAttribute("aria-pressed", item === button ? "true" : "false"));
      items.forEach((item) => {
        const tags = (item.dataset.tags || "").split(" ");
        item.hidden = filter !== "all" && !tags.includes(filter);
      });
    });
  });
</script>
