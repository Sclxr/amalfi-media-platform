---
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { money, site } from "../../site.config";
import drone from "../../assets/svc-drone.webp";
---
<Base title="Orlando Real Estate Drone Photos | Amalfi Media" description="Aerial photos of Orlando listings, lots, and neighborhoods." path="/services/drone/">
  <section class="page-hero wrap">
    <p class="eyebrow">Drone</p>
    <h1 class="display">Aerials for the <span class="gold">listing</span></h1>
    <p class="lead">Photos from above for the lot and the neighborhood.</p>
  </section>
  <section class="sec sec-light">
    <div class="wrap cards">
      <article class="card">
        <div class="media"><Picture src={drone} formats={["avif", "webp"]} fallbackFormat="webp" widths={[640, 1000]} alt="Aerial view of homes beside water and trees" /></div>
        <div class="bd">
          <h3>{money(site.prices.drone)}</h3>
          <ul>
            <li>Aerial property photos</li>
            <li>Neighborhood context when it helps the listing</li>
          </ul>
          <a class="btn btn-gold" href="/book/">Book drone</a>
        </div>
      </article>
    </div>
  </section>
</Base>
