---
import Base from "../layouts/Base.astro";
import { money, site } from "../site.config";
---
<Base title="Real Estate Media Pricing | Amalfi Media" description="Listing packages and individual prices for Amalfi Media in the greater Orlando area." path="/pricing/">
  <section class="page-hero wrap">
    <p class="eyebrow">Pricing</p>
    <h1 class="display">Packages, <span class="gold">clearly marked</span></h1>
    <p class="lead">Listing packages and single services.</p>
  </section>
  <section class="sec sec-light">
    <div class="wrap">
      <div class="packages">
        <article class="package">
          <h2>Basic</h2>
          <p class="price">{money(site.prices.basic)}</p>
          <ul><li>Listing photos</li><li>Drone photos</li></ul>
          <a class="btn btn-gold" href="/book/">Book basic</a>
        </article>
        <article class="package popular">
          <h2>Complete</h2>
          <p class="price">{money(site.prices.complete)}</p>
          <ul><li>Listing photos</li><li>Drone photos</li><li>Walkthrough video</li></ul>
          <a class="btn btn-gold" href="/book/">Book complete</a>
        </article>
      </div>
      <div class="alacarte">
        <article><h3>Photos</h3><p class="price">{money(site.prices.photo)}</p></article>
        <article><h3>Drone</h3><p class="price">{money(site.prices.drone)}</p></article>
        <article><h3>Video</h3><p class="price">{money(site.prices.video)}</p></article>
      </div>
    </div>
  </section>
</Base>
