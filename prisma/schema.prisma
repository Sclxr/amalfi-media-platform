// Auth models generated by Better Auth CLI 1.7.14 (prisma adapter, postgresql)
// and extended with Amalfi business relations. Regenerate auth tables with:
//   pnpm dlx auth@1.7.14 generate --config src/server/auth/auth-cli.ts --adapter prisma --dialect postgresql -y
// Then re-apply the business models and relations below.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app (Neon pooler). Migrations use DIRECT_URL.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  STAFF
  CLIENT
}

enum LeadStatus {
  NEW
  CONTACTED
  ENGAGED
  QUALIFIED
  NURTURE
  CONVERTED
  LOST
  DO_NOT_CONTACT
}

enum ActivityType {
  NOTE
  CALL
  EMAIL_SENT
  EMAIL_RECEIVED
  EMAIL_BOUNCED
  MEETING
  STATUS_CHANGE
  IMPORTED
  CONVERTED
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
}

enum EmailCategory {
  MARKETING
  TRANSACTIONAL
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

enum EmailStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  QUEUED
  SENT
  DELIVERED
  OPENED
  REPLIED
  BOUNCED
  COMPLAINED
  FAILED
  SUPPRESSED
}

enum SuppressionReason {
  UNSUBSCRIBED
  HARD_BOUNCE
  SPAM_COMPLAINT
  MANUAL
  INVALID_ADDRESS
}

enum PropertyType {
  SINGLE_FAMILY
  CONDO
  TOWNHOUSE
  MULTI_FAMILY
  LAND
  COMMERCIAL
  RENTAL
  OTHER
}

enum ServiceKind {
  PHOTO
  DRONE
  VIDEO
  SHORT_FORM
  TWILIGHT
  FLOOR_PLAN
  OTHER
}

enum PricingMode {
  FIXED
  QUOTE
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OrderStatus {
  REQUESTED
  QUOTED
  CONFIRMED
  SCHEDULED
  SHOOT_COMPLETE
  EDITING
  READY_FOR_DELIVERY
  DELIVERED
  ARCHIVED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  PARTIALLY_PAID
  VOID
  UNCOLLECTIBLE
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum MediaKind {
  PHOTO
  VIDEO
  DOCUMENT
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum GalleryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

// ---------- Identity (Better Auth) ----------

model User {
  id               String      @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name             String
  email            String
  emailVerified    Boolean     @default(false)
  image            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  twoFactorEnabled Boolean?    @default(false)
  /// Application role. Constrained to ADMIN, STAFF, CLIENT in the migration.
  role             String      @default("CLIENT")
  disabledAt       DateTime?
  lastLoginAt      DateTime?
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]

  permissions       UserPermission[]
  client            Client?
  ownedLeads        Lead[]               @relation("LeadOwner")
  activities        LeadActivity[]
  reminders         Reminder[]
  assignedBookings  Booking[]            @relation("BookingPhotographer")
  statusChanges     OrderStatusHistory[]
  uploads           MediaAsset[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  approvedCampaigns Campaign[]           @relation("CampaignApprover")
  createdCampaigns  Campaign[]           @relation("CampaignCreator")
  importBatches     ImportBatch[]
  refunds           Refund[]

  @@unique([email])
  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  secret                  String
  backupCodes             String
  userId                  String    @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ---------- Access ----------

model Permission {
  key         String           @id
  description String
  roles       RolePermission[]
  users       UserPermission[]
}

model RolePermission {
  role          Role
  permissionKey String
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([role, permissionKey])
}

model UserPermission {
  userId        String     @db.Uuid
  permissionKey String
  granted       Boolean    @default(true)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([userId, permissionKey])
}

model ApiClient {
  id         String     @id @default(cuid())
  name       String
  keyPrefix  String     @unique
  keyHash    String
  scopes     String[]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())
  auditLogs  AuditLog[]
}

// ---------- CRM ----------

model Brokerage {
  id        String   @id @default(cuid())
  name      String
  nameKey   String   @unique
  phone     String?
  website   String?
  address   String?
  city      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  leads      Lead[]
  clients    Client[]
}

model LeadSource {
  id    String @id @default(cuid())
  name  String @unique
  leads Lead[]
}

model Lead {
  id              String     @id @default(cuid())
  firstName       String?
  lastName        String?
  email           String?
  emailNormalized String?    @unique
  phone           String?
  phoneE164       String?
  brokerageId     String?
  sourceId        String?
  ownerId         String?    @db.Uuid
  status          LeadStatus @default(NEW)
  score           Int        @default(0)
  tags            String[]
  city            String?
  nextFollowUpAt  DateTime?
  lastContactedAt DateTime?
  importBatchId   String?
  externalRef     String?    @unique
  convertedAt     DateTime?
  clientId        String?    @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  brokerage   Brokerage?     @relation(fields: [brokerageId], references: [id])
  source      LeadSource?    @relation(fields: [sourceId], references: [id])
  owner       User?          @relation("LeadOwner", fields: [ownerId], references: [id])
  importBatch ImportBatch?   @relation(fields: [importBatchId], references: [id])
  client      Client?        @relation(fields: [clientId], references: [id])
  activities  LeadActivity[]
  reminders   Reminder[]
  emails      EmailMessage[]
  properties  Property[]

  @@index([status, nextFollowUpAt])
  @@index([phoneE164])
  @@index([brokerageId])
  @@index([ownerId])
}

model LeadActivity {
  id        String       @id @default(cuid())
  leadId    String
  actorId   String?      @db.Uuid
  type      ActivityType
  summary   String
  data      Json?
  createdAt DateTime     @default(now())
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor     User?        @relation(fields: [actorId], references: [id])

  @@index([leadId, createdAt])
}

model Reminder {
  id          String    @id @default(cuid())
  leadId      String?
  clientId    String?
  userId      String    @db.Uuid
  dueAt       DateTime
  note        String
  completedAt DateTime?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId, dueAt])
}

model ImportBatch {
  id          String   @id @default(cuid())
  fileName    String
  fileKey     String
  mapping     Json
  totalRows   Int
  createdRows Int      @default(0)
  mergedRows  Int      @default(0)
  skippedRows Int      @default(0)
  errors      Json?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  archivedAt  DateTime?
  createdBy   User      @relation(fields: [createdById], references: [id])
  leads       Lead[]
}

model Client {
  id                    String   @id @default(cuid())
  userId                String?  @unique @db.Uuid
  brokerageId           String?
  firstName             String
  lastName              String
  email                 String
  phone                 String?
  licenseNo             String?
  privateNotes          String?
  /// Admin-controlled exception to pay-before-download.
  allowUnpaidDownloads  Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  archivedAt            DateTime?

  user       User?      @relation(fields: [userId], references: [id])
  brokerage  Brokerage? @relation(fields: [brokerageId], references: [id])
  lead       Lead?
  properties Property[]
  orders     Order[]
  invoices   Invoice[]
  galleries  Gallery[]
  reminders  Reminder[]

  @@index([email])
  @@index([brokerageId])
}

// ---------- Email marketing ----------

model EmailTemplate {
  id        String        @id @default(cuid())
  key       String        @unique
  category  EmailCategory
  subject   String
  bodyMjml  String
  updatedAt DateTime      @updatedAt
}

model Campaign {
  id           String         @id @default(cuid())
  name         String
  status       CampaignStatus @default(DRAFT)
  subject      String
  body         String
  fromName     String
  fromEmail    String
  scheduledAt  DateTime?
  createdById  String         @db.Uuid
  approvedById String?        @db.Uuid
  approvedAt   DateTime?
  source       String         @default("admin")
  /// Who this campaign is for. Null means every contactable realtor. Old rows stay valid.
  segment      Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  archivedAt   DateTime?
  createdBy    User           @relation("CampaignCreator", fields: [createdById], references: [id])
  approvedBy   User?          @relation("CampaignApprover", fields: [approvedById], references: [id])
  messages     EmailMessage[]

  @@index([status, scheduledAt])
}

model EmailMessage {
  id            String         @id @default(cuid())
  campaignId    String?
  leadId        String?
  category      EmailCategory
  direction     EmailDirection @default(OUTBOUND)
  status        EmailStatus    @default(DRAFT)
  toEmail       String
  subject       String
  bodyHtml      String
  providerId    String?        @unique
  gmailThreadId String?
  sentAt        DateTime?
  openedAt      DateTime?
  repliedAt     DateTime?
  bouncedAt     DateTime?
  error         String?
  createdAt     DateTime       @default(now())
  campaign      Campaign?      @relation(fields: [campaignId], references: [id])
  lead          Lead?          @relation(fields: [leadId], references: [id])

  @@unique([campaignId, leadId])
  @@index([toEmail])
  @@index([status])
}

model EmailSuppression {
  id              String            @id @default(cuid())
  emailNormalized String            @unique
  reason          SuppressionReason
  source          String?
  createdAt       DateTime          @default(now())
}

// ---------- Catalog ----------

model Service {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  kind        ServiceKind
  pricingMode PricingMode    @default(FIXED)
  priceCents  Int?
  durationMin Int            @default(60)
  isAddOn     Boolean        @default(false)
  active      Boolean        @default(true)
  sortOrder   Int            @default(0)
  packages    PackageService[]
  addOnFor    PackageAddOn[]
  orderItems  OrderItem[]
}

model Package {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  priceCents  Int
  maxSqft     Int?
  durationMin Int
  active      Boolean          @default(true)
  sortOrder   Int              @default(0)
  services    PackageService[]
  addOns      PackageAddOn[]
  orderItems  OrderItem[]
}

model PackageService {
  packageId String
  serviceId String
  quantity  Int      @default(1)
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([packageId, serviceId])
}

model PackageAddOn {
  packageId          String
  serviceId          String
  overridePriceCents Int?
  package            Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service            Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([packageId, serviceId])
}

model ServiceArea {
  id             String   @id @default(cuid())
  name           String
  zipCodes       String[]
  travelFeeCents Int      @default(0)
  active         Boolean  @default(true)
}

model AvailabilityRule {
  id       String  @id @default(cuid())
  weekday  Int
  startMin Int
  endMin   Int
  userId   String? @db.Uuid
}

model BlackoutDate {
  id     String   @id @default(cuid())
  date   DateTime @db.Date
  reason String?
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------- Properties, bookings, orders ----------

model Property {
  id           String       @id @default(cuid())
  clientId     String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String       @default("FL")
  zip          String
  lat          Float?
  lng          Float?
  propertyType PropertyType
  sqft         Int?
  beds         Int?
  bathsHalf    Int?
  accessNotes  String?
  createdAt    DateTime     @default(now())
  archivedAt   DateTime?
  /// CRM realtor. Null on older rows until someone assigns one.
  leadId       String?
  /// Staff-chosen cover. Empty falls back to the first ready photo on a published gallery.
  coverAssetId String?      @unique
  client       Client       @relation(fields: [clientId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  coverAsset   MediaAsset?  @relation("ListingCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  orders       Order[]
  galleries    Gallery[]

  @@index([clientId])
  @@index([leadId])
  @@index([zip])
}

model Order {
  id             String      @id @default(cuid())
  number         Int         @unique @default(autoincrement())
  clientId       String
  propertyId     String
  status         OrderStatus @default(REQUESTED)
  subtotalCents  Int         @default(0)
  travelFeeCents Int         @default(0)
  discountCents  Int         @default(0)
  totalCents     Int         @default(0)
  preferredDate  DateTime?   @db.Date
  instructions   String?
  internalNotes  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  archivedAt     DateTime?
  client         Client      @relation(fields: [clientId], references: [id])
  property       Property    @relation(fields: [propertyId], references: [id])
  items          OrderItem[]
  bookings       Booking[]
  history        OrderStatusHistory[]
  invoices       Invoice[]
  galleries      Gallery[]

  @@index([status, updatedAt])
  @@index([clientId, createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  packageId      String?
  serviceId      String?
  label          String
  quantity       Int      @default(1)
  unitPriceCents Int?
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  package        Package? @relation(fields: [packageId], references: [id])
  service        Service? @relation(fields: [serviceId], references: [id])

  @@index([orderId])
}

model Booking {
  id                String        @id @default(cuid())
  orderId           String
  photographerId    String?       @db.Uuid
  status            BookingStatus @default(REQUESTED)
  startAt           DateTime?
  endAt             DateTime?
  durationMin       Int
  travelFeeCents    Int           @default(0)
  rescheduledFromId String?       @unique
  cancelledAt       DateTime?
  cancelReason      String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photographer      User?         @relation("BookingPhotographer", fields: [photographerId], references: [id])
  rescheduledFrom   Booking?      @relation("Reschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo     Booking?      @relation("Reschedule")

  @@index([startAt])
  @@index([photographerId, startAt])
  @@index([status])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?      @db.Uuid
  note       String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor      User?        @relation(fields: [actorId], references: [id])

  @@index([orderId, createdAt])
}

// ---------- Billing ----------

model Invoice {
  id                      String        @id @default(cuid())
  number                  String        @unique
  clientId                String
  orderId                 String?
  status                  InvoiceStatus @default(DRAFT)
  currency                String        @default("usd")
  subtotalCents           Int
  taxCents                Int           @default(0)
  totalCents              Int
  amountPaidCents         Int           @default(0)
  amountRefundedCents     Int           @default(0)
  dueAt                   DateTime?
  issuedAt                DateTime?
  paidAt                  DateTime?
  stripeCheckoutSessionId String?       @unique
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  client                  Client        @relation(fields: [clientId], references: [id])
  order                   Order?        @relation(fields: [orderId], references: [id])
  lineItems               InvoiceLineItem[]
  payments                Payment[]

  @@index([clientId, status])
  @@index([status, dueAt])
}

model InvoiceLineItem {
  id             String  @id @default(cuid())
  invoiceId      String
  description    String
  quantity       Int     @default(1)
  unitPriceCents Int
  totalCents     Int
  sortOrder      Int     @default(0)
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id                    String        @id @default(cuid())
  invoiceId             String
  status                PaymentStatus
  amountCents           Int
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?       @unique
  receiptUrl            String?
  method                String?
  createdAt             DateTime      @default(now())
  invoice               Invoice       @relation(fields: [invoiceId], references: [id])
  refunds               Refund[]

  @@index([invoiceId])
}

model Refund {
  id             String       @id @default(cuid())
  paymentId      String
  amountCents    Int
  status         RefundStatus @default(PENDING)
  reason         String?
  stripeRefundId String?      @unique
  createdById    String?      @db.Uuid
  createdAt      DateTime     @default(now())
  payment        Payment      @relation(fields: [paymentId], references: [id])
  createdBy      User?        @relation(fields: [createdById], references: [id])
}

model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ---------- Media ----------

model Gallery {
  id          String        @id @default(cuid())
  orderId     String
  clientId    String
  propertyId  String
  title       String
  status      GalleryStatus @default(DRAFT)
  /// Full-resolution and ZIP downloads require a paid invoice unless the client has allowUnpaidDownloads.
  requirePaid       Boolean       @default(true)
  /// Previews are the original file with no watermark burned in.
  previewWatermark  Boolean       @default(false)
  publishedAt DateTime?
  zipKey      String?
  zipBuiltAt  DateTime?
  createdAt   DateTime      @default(now())
  order       Order         @relation(fields: [orderId], references: [id])
  client      Client        @relation(fields: [clientId], references: [id])
  property    Property      @relation(fields: [propertyId], references: [id])
  assets      MediaAsset[]

  @@index([clientId, status])
}

model MediaAsset {
  id           String      @id @default(cuid())
  galleryId    String
  kind         MediaKind
  status       MediaStatus @default(UPLOADING)
  storageKey   String      @unique
  previewKey   String?
  fileName     String
  mimeType     String
  sizeBytes    BigInt
  width        Int?
  height       Int?
  durationSec  Int?
  checksum     String?
  sortOrder    Int         @default(0)
  uploadedById String      @db.Uuid
  createdAt    DateTime    @default(now())
  gallery      Gallery     @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  uploadedBy   User        @relation(fields: [uploadedById], references: [id])
  listingCover Property?   @relation("ListingCover")

  @@index([galleryId, sortOrder])
}

// ---------- Notifications and audit ----------

model Notification {
  id        String              @id @default(cuid())
  userId    String              @db.Uuid
  channel   NotificationChannel
  type      String
  title     String
  body      String
  data      Json?
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id          String    @id @default(cuid())
  actorId     String?   @db.Uuid
  apiClientId String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  actor       User?     @relation(fields: [actorId], references: [id])
  apiClient   ApiClient? @relation(fields: [apiClientId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}
